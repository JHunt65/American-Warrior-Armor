<div class="page-width">
  <div class="grid">
    <div class="grid__item medium-up--five-sixths medium-up--push-one-twelfth">
      <div class="section-header text-center">
        <h1 class="store-page-title">{{ page.title }}</h1>
      {% if page.metafields.custom.subtitle.value != blank %}
        <p class="store-page-subtitle">{{ page.metafields.custom.subtitle.value | escape }}</p>
      {% endif %}
      </div>

      <div class="rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>
