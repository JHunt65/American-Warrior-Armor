  .martial-arts-hero__stamp b { transform:rotate(-10deg) }
  .martial-arts-hero__stamp span { transform:rotate(-10deg) }
}

@media (prefers-reduced-motion: reduce) {
  .martial-arts-hero__video { display:none }
  .site-nav a.site-nav__martial-link:hover::before,
  .site-nav a.site-nav__martial-link:hover::after,
  .site-nav a.site-nav__martial-link:focus-visible::before,
  .site-nav a.site-nav__martial-link:focus-visible::after { animation:none; opacity:1 }
  .site-nav a.site-nav__martial-link:hover::before,
  .site-nav a.site-nav__martial-link:focus-visible::before { transform:translate(-50%, -50%) rotate(45deg) scaleX(1) }
  .site-nav a.site-nav__martial-link:hover::after,
  .site-nav a.site-nav__martial-link:focus-visible::after { transform:translate(-50%, -50%) rotate(-45deg) scaleX(1) }
}

input:not([type="checkbox"]):not([type="radio"]),
