.site-nav__discipline-wrap { display:flex; align-items:center; margin:0; padding:10px 0; list-style:none }
.site-nav__disciplines { position:relative; z-index:1; display:flex; align-items:center; gap:clamp(16px, 2vw, 28px); margin:0; padding:0; list-style:none }
.site-nav__disciplines .site-nav__link { padding:16px 4px; font-size:15px; font-weight:800; letter-spacing:.05em; white-space:nowrap }
.site-nav__disciplines .site-nav__link:hover { color:#e53935 }
.site-nav a.site-nav__martial-link { overflow:visible }
.site-nav a.site-nav__martial-link > span { position:relative; display:inline-block }
.site-nav a.site-nav__martial-link > span::before,
.site-nav a.site-nav__martial-link > span::after {
  position:absolute;
  top:50%;
  left:50%;
  z-index:2;
  display:block;
  width:60px;
  height:6px;
  transform:translate(-50%, -50%) scaleX(0);
  border-radius:3px;
  background:#e53935;
  content:"";
  opacity:0;
  pointer-events:none;
}
.site-nav a.site-nav__martial-link > span::before { transform:translate(-50%, -50%) rotate(45deg) scaleX(0) }
.site-nav a.site-nav__martial-link > span::after { transform:translate(-50%, -50%) rotate(-45deg) scaleX(0) }
.site-nav a.site-nav__martial-link:hover,
.site-nav a.site-nav__martial-link:focus-visible { color:#e53935 !important }
.site-nav a.site-nav__martial-link:hover > span::before,
.site-nav a.site-nav__martial-link:focus-visible > span::before { animation:martial-x-slam-positive .38s cubic-bezier(.2, 1.7, .45, 1) forwards }
.site-nav a.site-nav__martial-link:hover > span::after,
.site-nav a.site-nav__martial-link:focus-visible > span::after { animation:martial-x-slam-negative .38s cubic-bezier(.2, 1.7, .45, 1) forwards }
@keyframes martial-x-slam-positive {
  0% { transform:translate(-50%, -50%) rotate(45deg) scaleX(0); opacity:0 }
  65% { transform:translate(-50%, -50%) rotate(45deg) scaleX(1.12); opacity:1 }
  100% { transform:translate(-50%, -50%) rotate(45deg) scaleX(1); opacity:1 }
}
@keyframes martial-x-slam-negative {
  0% { transform:translate(-50%, -50%) rotate(-45deg) scaleX(0); opacity:0 }
  65% { transform:translate(-50%, -50%) rotate(-45deg) scaleX(1.12); opacity:1 }
  100% { transform:translate(-50%, -50%) rotate(-45deg) scaleX(1); opacity:1 }
}

.martial-arts-hero {
  position:relative;
  display:flex;
  min-height:clamp(420px, 48vw, 680px);
  align-items:center;
  overflow:hidden;
  background:#111;
  color:#fff;
}
.martial-arts-hero::after {
  position:absolute;
  z-index:0;
  top:50%;
  right:7%;
  width:clamp(340px, 38vw, 490px);
  aspect-ratio:1;
  transform:translateY(-50%);
  border:1px solid rgba(255,255,255,.14);
  border-radius:50%;
  box-shadow:0 0 0 34px rgba(255,255,255,.03), 0 0 0 80px rgba(255,255,255,.02);
  content:"";
  pointer-events:none;
}
.martial-arts-hero__video,
.martial-arts-hero__overlay {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}
.martial-arts-hero__video { z-index:1; object-fit:cover; object-position:center 44% }
.martial-arts-hero__overlay {
  z-index:2;
  background:linear-gradient(90deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.52) 43%, rgba(0,0,0,.12) 100%), linear-gradient(0deg, rgba(0,0,0,.2), transparent 55%);
}
.martial-arts-hero__content { position:relative; z-index:3; padding-top:72px; padding-bottom:72px }
.martial-arts-hero__stamp {
  position:absolute;
  z-index:3;
  top:50%;
  right:15%;
  display:grid;
  width:235px;
  height:235px;
  place-content:center;
  transform:translateY(-50%);
  border:2px solid #e53935;
  border-radius:50%;
  color:#fff;
  text-align:center;
  pointer-events:none;
}
.martial-arts-hero__stamp b { display:block; margin-top:-22px; color:#ff625c; font-size:92px; line-height:.9; letter-spacing:0; text-align:center; transform:rotate(-10deg) }
.martial-arts-hero__stamp span { display:block; margin-top:10px; font-size:14px; line-height:1.35; font-weight:700; letter-spacing:.1em; text-indent:.1em; text-align:center; transform:rotate(-10deg); text-transform:uppercase }
.martial-arts-hero__eyebrow { margin:0 0 16px; color:#ff7770; font-size:12px; font-weight:750; letter-spacing:.2em; text-transform:uppercase }
.martial-arts-hero__heading {
  max-width:780px;
  margin:0 0 18px;
  color:#fff;
  font-size:clamp(48px, 7vw, 92px);
  font-weight:850;
  letter-spacing:-.06em;
  line-height:.98;
  text-transform:uppercase;
}
.martial-arts-hero__subheading { max-width:560px; margin:0 0 28px; color:#f0f0f0; font-size:clamp(16px, 1.8vw, 20px); line-height:1.65 }
.martial-arts-hero__button {
  display:inline-flex;
  min-height:48px;
  align-items:center;
  justify-content:center;
  padding:13px 24px;
  border-radius:6px;
  background:#e53935;
  color:#fff;
  font-size:12px;
  font-weight:750;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.martial-arts-hero__button:hover { transform:translateY(-2px); background:#c92e2b; color:#fff }
.martial-arts-hero__toggle {
  position:absolute;
  z-index:3;
  right:28px;
  bottom:24px;
  min-height:40px;
  padding:9px 14px;
  border:1px solid rgba(255,255,255,.5);
  border-radius:5px;
  background:rgba(0,0,0,.45);
  color:#fff;
  cursor:pointer;
  font-size:11px;
  font-weight:700;
}
.martial-arts-hero__toggle:hover { background:rgba(0,0,0,.75) }

.martial-art-page { background:#fff; color:#111111 }
.martial-art-page__hero {
  padding:clamp(76px, 10vw, 132px) 0 clamp(68px, 8vw, 108px);
  background:radial-gradient(circle at 78% 48%, rgba(229,57,53,.12), transparent 24%), linear-gradient(120deg, #111722 0%, #202a39 100%);
  color:#fff;
}
.martial-art-page__eyebrow { margin:0 0 16px; color:#e53935; font-size:12px; font-weight:750; letter-spacing:.18em; text-transform:uppercase }
.martial-art-page__hero h1 { margin:0 0 20px; color:#fff; font-size:clamp(48px, 8vw, 88px); font-weight:850; letter-spacing:-.06em; line-height:.98; text-transform:uppercase }
.martial-art-page__intro { max-width:650px; margin:0 0 28px; color:#d5dbe5; font-size:clamp(17px, 2vw, 20px); line-height:1.7 }
.martial-art-page__button {
  display:inline-flex;
  min-height:48px;
  align-items:center;
  justify-content:center;
  padding:13px 24px;
  border-radius:6px;
  background:#e53935;
  color:#fff;
  font-size:12px;
  font-weight:750;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.martial-art-page__button:hover { background:#c92e2b; color:#fff }
.martial-art-page__nav { display:flex; flex-wrap:wrap; gap:10px; padding-top:24px; padding-bottom:24px; border-bottom:1px solid #e5e7eb }
.martial-art-page__nav a { padding:10px 16px; border:1px solid #d8dde5; border-radius:999px; color:#111111; font-size:12px; font-weight:750 }
.martial-art-page__nav a:hover,
.martial-art-page__nav a[aria-current="page"] { border-color:#e53935; background:#e53935; color:#fff }
.martial-art-page__gear { padding-top:clamp(48px, 7vw, 88px); padding-bottom:clamp(56px, 8vw, 100px) }
.martial-art-page__section-heading { max-width:700px; margin-bottom:32px }
.martial-art-page__section-heading h2 { margin:0 0 12px; font-size:clamp(30px, 4vw, 46px); font-weight:800; letter-spacing:-.04em; line-height:1.08 }
.martial-art-page__section-heading > p:last-child { color:#5e6877; font-size:16px; line-height:1.65 }
.martial-art-page__grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:16px; margin:0; padding:0; list-style:none }
.martial-art-page__card { min-height:190px; padding:24px; border:1px solid #e5e7eb; border-radius:12px; background:#fff; box-shadow:0 8px 28px rgba(17,24,39,.045) }
.martial-art-page__number { display:inline-flex; width:30px; height:30px; align-items:center; justify-content:center; margin-bottom:18px; border-radius:50%; background:#fff0ef; color:#e53935; font-size:11px; font-weight:800 }
.martial-art-page__card h3 { margin:0 0 10px; font-size:18px; font-weight:800; line-height:1.25 }
.martial-art-page__card p { margin:0; color:#5e6877; font-size:14px; line-height:1.65 }
.martial-art-page__note { margin:22px 0 0; color:#687385; font-size:13px }

.curated-reviews {
  padding:42px 24px 40px;
  border-bottom:1px solid #e5e7eb;
  background:#fbfbfb;
}
.curated-reviews__inner {
  max-width:1440px;
  margin:0 auto;
}
.curated-reviews__heading { margin-bottom:44px; text-align:center }
.curated-reviews__eyebrow { margin:0 0 8px; color:#e53935; font-size:12px; font-weight:750; letter-spacing:.2em; text-transform:uppercase }
.curated-reviews__heading h2 { margin:0; color:#111111; font-size:clamp(26px, 3vw, 38px); font-weight:800; letter-spacing:-.04em; line-height:1.1 }
.curated-reviews__viewport { position:relative; overflow-x:auto; overscroll-behavior-x:contain; scroll-behavior:smooth; scroll-snap-type:x mandatory; scrollbar-width:none }
.curated-reviews__viewport::-webkit-scrollbar { display:none }
.curated-reviews__track { display:flex; gap:12px; align-items:stretch }
.curated-review {
  display:flex;
  flex:0 0 calc((100% - 72px) / 7);
  min-width:0;
  min-height:140px;
  flex-direction:column;
  padding:12px;
  border:1px solid #e5e7eb;
  border-radius:9px;
  background:#fff;
  text-align:center;
  scroll-snap-align:start;
}
.curated-review__stars { margin-bottom:10px; color:#e53935; font-size:13px; letter-spacing:.08em; white-space:nowrap }
.curated-review__stars--placeholder { color:#e53935 }
.curated-review__text,
.curated-review__empty { margin:auto 0; color:#4b5563; font-size:12px; line-height:1.5; overflow-wrap:anywhere; text-align:center }
.curated-review__empty { color:#8a929e; font-style:italic }
.curated-review__byline { display:grid; gap:3px; margin-top:0; padding-top:10px; border-top:1px solid #f0f1f3 }
.curated-review__author { color:#171c24; font-size:12px; font-weight:750; text-align:center }
.curated-review__product { color:#77808e; font-size:11px; text-align:center }

