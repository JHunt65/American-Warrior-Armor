.headerTop .page-width { display:flex; justify-content:flex-end; align-items:center }
.site-header__icons-wrapper { display:flex; align-items:center }
.site-header__icons-wrapper > ul { display:flex; align-items:center; gap:20px }
.site-header__icons-wrapper > ul li { border:0; padding:0; margin:0 }
.mailIc { color:#d9deea; font-size:12px; font-weight:500 }
.mailIc a { margin-left:5px; font-weight:600 }
.search-header__input,
.search-bar__input {
  height:36px;
  padding:8px 42px 8px 14px;
  border:1px solid rgba(255,255,255,.25);
  border-radius:6px;
  background:rgba(255,255,255,.08);
  font-size:13px;
}
.site-header .search-header__submit { right:5px; width:36px; height:36px }
.site-header__cart { position:relative; display:flex; align-items:center; min-height:34px }
.site-header__cart img { width:23px; height:auto; padding:0; filter:brightness(0) invert(1) }
.cartCount { top:-5px; right:-12px; width:19px; height:19px; border:0; background:#e53935; color:#fff; font-size:11px; line-height:19px }
.headerBottom { background:#fff; border-bottom:1px solid #e7e7e7 }
.headerBottom > .page-width { display:flex; align-items:center; justify-content:space-between; min-height:92px }
.headerLeft,
.headerRight { display:block; width:auto; margin:0; text-align:initial }
.site-header__logo { margin:0; padding:0; line-height:0 }
.site-header__logo img { width:140px; height:auto; max-height:none; object-fit:contain }
.headerBottom .headerLeft .h2.site-header__logo .site-header__logo-image { display:flex; align-items:center; gap:14px }
.site-header__formerly { display:block; max-width:190px; color:#555; text-align:left; white-space:normal }
.site-header__formerly b { display:block; color:#e53935; font-size:11px; font-weight:800; line-height:1.2; letter-spacing:.1em; text-transform:uppercase }
.site-header__formerly em { display:block; margin-top:4px; font-size:12px; font-style:normal; font-weight:600; line-height:1.35; letter-spacing:0; text-transform:none }
@media screen and (max-width:1100px) { .site-header__formerly em { display:none } }
@media screen and (max-width:760px) { .site-header__formerly { display:none } }
.header--page .headerBottom { background:#fff }
.header--page .site-header__logo { margin:0; padding:0 }
.header--page .headerBottom #SiteNav a { color:#111111 }
.site-nav { display:flex; align-items:center; gap:clamp(12px, 1.5vw, 22px); margin:0; padding:0 }
.site-nav li { display:inline-block }
.site-nav > li > a.site-nav__link--main {
  padding:16px 10px;
  font-size:15px;
  font-weight:800;
  letter-spacing:.05em;
  white-space:nowrap;
}
.site-nav a,
.header--page .headerBottom #SiteNav a {
  position:relative;
  z-index:0;
  overflow:hidden;
  padding:14px 13px;
  border-radius:6px;
  color:#111111;
  font-size:12px;
  font-weight:700;
  letter-spacing:.07em;
  transition:color .2s ease, background-color .2s ease;
}
.site-nav a:after,
.template-index .site-nav a:after { display:none }
.site-nav a.site-nav__martial-link::after,
.template-index .site-nav a.site-nav__martial-link::after,
.header--page .headerBottom #SiteNav a.site-nav__martial-link::after { display:block; width:60px; height:6px; background:#e53935 !important }
.site-nav a:hover,
.template-index .site-nav a:hover,
.header--page .headerBottom #SiteNav a:hover {
  color:#e53935 !important;
  background:rgba(229,57,53,.08);
}
.site-nav__link .icon-chevron-down,
.template-index .site-nav__link .icon-chevron-down { fill:currentColor }

.template-index .main-content { padding-top:0 }
.template-index .slideshow { height:clamp(350px, 41vw, 620px); margin:0 }
.slideshow .slideshow__slide,
.slideshow .slick-list,
.slideshow .slick-track { height:100% }
.slideshow__image { background-position:center center !important }
.slideshow__overlay::before { background:linear-gradient(90deg, rgba(17,24,39,.32), transparent 75%); opacity:1 }
.slideshow__text-content { text-align:left }
.slideshow__text-content .page-width { max-width:1440px }
.slideshow__title {
  max-width:760px;
  margin:0 0 14px;
  font-size:clamp(34px, 5vw, 68px);
  font-weight:800;
  letter-spacing:-.04em;
  line-height:1.03;
  text-shadow:0 3px 20px rgba(0,0,0,.24);
}
.slideshow__subtitle {
  display:block;
  max-width:560px;
  font-size:clamp(16px, 1.7vw, 21px);
  line-height:1.55;
  text-shadow:0 2px 12px rgba(0,0,0,.4);
}
.slideshow .slick-dots { display:block !important; bottom:18px; z-index:4 }
.slideshow .slick-dots li button:before { font-size:9px; opacity:.5 }
.slideshow .slick-dots li.slick-active button:before { opacity:1 }
.slideshow .slick-prev.slick-arrow,
.slideshow .slick-next.slick-arrow { z-index:4; opacity:.8 }

.index-section { padding-top:56px; padding-bottom:56px }
