/* Modern storefront refresh */

html { scroll-behavior:smooth }
body, input, textarea, button, select {
  font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
body { color:#111111; background:#fff }
a { transition:color .2s ease, background-color .2s ease, border-color .2s ease }
.page-width { max-width:1440px; padding-left:32px; padding-right:32px }

.announcement-bar,
.announcement-bar--link:hover { background-color:#e53935 !important }
.announcement-bar__message {
  padding:10px 20px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.site-header { background:#fff; box-shadow:0 5px 22px rgba(17,24,39,.07); z-index:11 }
