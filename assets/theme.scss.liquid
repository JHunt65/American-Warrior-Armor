.site-nav a {position:relative;transition: all 0.5s ease;}
.site-nav a:hover:after {width:100% !important;}
.site-nav a:hover {color:#f05541;}
.site-nav a:after {
	content:"";
	background:#fff;
	width:0;
	height:100%;
	position:absolute;
	top:0;
	left:0;
	transition: all 0.5s ease;
	z-index:-1;
}


.template-index .site-nav a:hover {color:#fff !important;}
.template-index .site-nav a:after {
	content:"";
	background:#f05541 !important;
	width:0;
	height:100%;
	position:absolute;
	top:0;
	left:0;
	transition: all 0.5s ease;
	z-index:-1;
}
.template-index .site-nav a.site-nav__link:hover .icon-chevron-down {fill: #fff;}




