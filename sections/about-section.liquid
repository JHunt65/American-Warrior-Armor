<div class="aboutSec" id="story">
  <div class="page-width">
    <div class="aboutLeft">
      {% if section.settings.title != blank %}
      <h2 class="secTitle">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.content != blank %}
      {{ section.settings.content }}
      {% endif %}
      {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="moreBtn">{{ section.settings.btn }}</a>
      {% endif %}
    </div>
    <div class="aboutRight">
      {% if section.settings.brand_logo != blank %}
      <img src="{{ section.settings.brand_logo | img_url: '400x' }}" alt="{{ section.settings.brand_logo.alt | default: shop.name | escape }}">
      {% else %}
      <img src="{{ 'american-warrior-armor-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="486" height="430">
      {% endif %}
    </div>
  </div>
  <svg class="about-swoosh" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 26 C 220 4, 470 4, 700 20 S 1100 36, 1200 8" pathLength="1" />
  </svg>
  <svg class="about-swoosh about-swoosh--top" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M1200 14 C 980 36, 730 36, 500 20 S 100 4, 0 32" pathLength="1" />
  </svg>
</div>
<script>
  (function () {
    var el = document.querySelector('.aboutSec');
    if (!el) return;
    if (!('IntersectionObserver' in window)) { el.classList.add('is-visible'); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { el.classList.add('is-visible'); io.disconnect(); } });
    }, { threshold: 0.35 });
    io.observe(el);
  })();
</script>

{% schema %}
  {
    "name": "About Section",
    "settings": [
	{
		"type":"text",
		"id":"title",
		"label":"Title"
	},
	{
		"type":"richtext",
		"id":"content",
		"label":"Text"
	},
	{
		"type":"text",
		"id":"btn",
		"label":"Button Name"
	},
	{
		"type":"url",
		"id":"link",
		"label":"Link"
	},
	{
		"type":"image_picker",
		"id":"brand_logo",
		"label":"Brand logo",
		"info":"Optional. Leave blank to use the American Warrior Armor theme logo."
	}

],
"presets":[
	{
		"name": "About Section",
		"category":"New"
	}
]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
