<div class="brand-slider">
  <div class="page-width">
    {% if section.settings.title != blank %}
    <div class="brand_title">{{ section.settings.title }}</div>
    {% endif %}
    <div class="brand-list">
      {% for block in section.blocks %}
      <div class="brand_box">
        <a href="{{ block.settings.link }}">
          {% if block.settings.img != blank %}
          <img src="{{ block.settings.img | img_url: 'master' }}" alt="">
          {% endif %}
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Logo name",
    "settings": [
	{
		"type":"text",
		"id":"title",
		"label":"Title"
	}
],
"blocks":[
	{
		"type":"image",
		"name":"logo",
		"settings":[
        {
          "type":"image_picker",
          "id":"img",
          "label":"Image"
        },
		{
          "type":"url",
          "id":"link",
          "label":"Link"
		}
	]
	}
],
"presets":[
	{
		"name": "Logo Section",
		"category":"New"
	}
]
  }
{% endschema %}

