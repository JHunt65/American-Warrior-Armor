<div id="shopify-section-1516211652395" class="shopify-section index-section searchgearSec searchgearSec--centered">
  <div class="page-width">
    <div class="gear-bar">
      <p class="gear-bar__label">Search for <b>your Gear</b></p>
      <form class="gear-jump gear-bar__form" action="{{ routes.all_products_collection_url }}">
        <select class="gear-jump__select" aria-label="Shop by martial art">
          <option value="">Shop by Martial Art</option>
          <option value="{{ routes.all_products_collection_url }}/mma?art=mma">MMA</option>
          <option value="{{ routes.all_products_collection_url }}/kickboxing?art=kickboxing">Kickboxing</option>
          <option value="{{ routes.all_products_collection_url }}/judo?art=judo">Judo</option>
          <option value="{{ routes.all_products_collection_url }}/bjj?art=bjj">BJJ</option>
          <option value="{{ routes.all_products_collection_url }}/karate?art=karate">Karate</option>
          <option value="{{ routes.all_products_collection_url }}">All Training Gear</option>
        </select>
        <button class="gear-bar__go" type="submit" aria-label="Go">&rarr;</button>
      </form>
    </div>

  </div>
</div>

{% schema %}
  {
    "name": "Search Section",
    "settings": [
],
"presets":[
	{
		"name": "Search Section",
		"category":"New"
	}
]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
  document.addEventListener('submit', function (e) {
    var form = e.target.closest ? e.target.closest('.gear-jump') : null;
    if (!form) return;
    e.preventDefault();
    var url = form.querySelector('.gear-jump__select').value;
    if (url) window.location.href = url;
  });
{% endjavascript %}
