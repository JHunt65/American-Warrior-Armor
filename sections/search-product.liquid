<div id="shopify-section-1516211652395" class="shopify-section index-section searchgearSec">
  <div class="page-width">
    <div class="custom-content">
      <div class="custom__item custom__item--1516211710854 small--one-whole medium-up--one-third" >
        <div class="custom__item-inner custom__item-inner--html">
          <p class="h5" style="text-align: right">Search for <b>your Gear</b> </p>
        </div>
      </div>
      <div class="custom__item custom__item--1516211716652 small--one-whole medium-up--two-thirds " >
        <div class="custom__item-inner custom__item-inner--html">
          <form class="gear-jump" style="max-width: 560px; margin: 0 auto;" action="{{ routes.all_products_collection_url }}">
            <select class="gear-jump__select" aria-label="Shop by martial art" style="width: 100%;">
              <option value="">Shop by Martial Art</option>
              <option value="{{ routes.all_products_collection_url }}/mma">MMA</option>
              <option value="{{ routes.all_products_collection_url }}/kickboxing">Kickboxing</option>
              <option value="{{ routes.all_products_collection_url }}/judo">Judo</option>
              <option value="{{ routes.all_products_collection_url }}/bjj">BJJ</option>
              <option value="{{ routes.all_products_collection_url }}/karate">Karate</option>
              <option value="{{ routes.all_products_collection_url }}">All Training Gear</option>
            </select>
            <button class="btn search__submit" type="submit">Go</button>
          </form>
        </div>
      </div>
      <!-- <div class="custom__item custom__item--1565781378951 small--one-half medium-up--one-half " >
<div class="custom__item-inner custom__item-inner--html">
<p></p>
<h1>Jitsu Armor Home Page</h1>
<p></p>
</div>
-->
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Search Section",
    "settings": [
],
"presets":[
	{
		"name": "Search Section",
		"category":"New"
	}
]
