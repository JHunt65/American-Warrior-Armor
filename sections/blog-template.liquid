{% paginate blog.articles by 24 %}
<div class="page-width">
  <header class="section-header text-center blog-page-header">
    <h1 class="blog-brand-title">The Warrior’s Edge</h1>
    <p class="blog-subtitle">Your place for martial arts knowledge and inspiration.</p>
    <p class="featured-blog-header__intro blog-page-intro">Explore martial arts training tips, detailed gear guides, and helpful insights from American Warrior Armor. Discover practical advice for Brazilian jiu-jitsu, MMA, kickboxing, judo, and karate to support your training journey. Learn how to choose the right equipment, care for your gear, and build your skills with confidence.</p>
    {% if blog.tags.size > 0 %}
      <select id="BlogTagFilter">
        <option value="/blogs/{{ blog.handle }}">{{ 'blogs.article.all_topics' | t }}</option>
        {% for tag in blog.all_tags %}
          <option value="/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" {% if current_tags contains tag %}selected{% endif %}>{{ tag }}</option>
        {% endfor %}
      </select>
    {% endif %}
  </header>
</div>

<section class="page-width" data-blog-pagination data-batch-page="{{ paginate.current_page }}" data-total-posts="{{ paginate.items }}" data-older-url="{{ paginate.next.url | escape }}" data-newer-url="{{ paginate.previous.url | escape }}">
  <div class="featured-blog-cards blog-page-cards" id="BlogPosts">
    {% for article in blog.articles %}
      {% include 'blog-post-card' %}
    {% else %}
      <p>No posts have been published yet.</p>
    {% endfor %}
  </div>
  <nav class="blog-post-pagination" aria-label="Blog post pages" data-blog-controls hidden>
    <a class="btn" data-blog-newer>Newer posts</a>
    <span data-blog-page-status aria-live="polite"></span>
    <a class="btn" data-blog-older>Older posts</a>
  </nav>
  <noscript>{% if paginate.pages > 1 %}{% include 'pagination' %}{% endif %}</noscript>
</section>
{% endpaginate %}
<script src="{{ 'blog-pagination.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Blog pages",
  "settings": [
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "Show date",
      "default": true
    }
  ]
}
{% endschema %}
