<div class="instaSec">
  <div class="page-width">
    {% if section.settings.title != blank %}
    <h2 class="instaTitle secTitle">{{ section.settings.title }}</h2>
    {% endif %}
  </div>
  <div id="instafeed">
    {% for index in (1..8) %}
      {% assign post_setting = 'post_url_' | append: index %}
      {% assign post_url = section.settings[post_setting] | default: 'https://www.instagram.com/americanwarriorarmor/' %}
      {% assign image_asset = 'insta-thum0' | append: index | append: '.png' %}
      <a href="{{ post_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="View Instagram {% if section.settings[post_setting] != blank %}post {{ index }}{% else %}profile{% endif %} (opens in a new tab)">
        <img src="{{ image_asset | asset_url }}" alt="American Warrior Armor Instagram photo {{ index }}" loading="lazy">
      </a>
    {% endfor %}
  </div>
</div>

